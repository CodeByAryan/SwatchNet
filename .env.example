# SwatchNet Environment Configuration (Example)
# Copy this file to .env before running the application. Never commit a real .env.
# Server
NODE_ENV=development
PORT=5000
# Client (local requests use Vite proxy; set VITE_API_BASE_URL in Vercel to the Render service URL)
API_PROXY_TARGET=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000/api
# Neon Auth public endpoint (same Neon Auth project/branch as backend).
# Copy the exact URL from Neon Console -> Auth -> Configuration.
VITE_NEON_AUTH_URL=https://your-neon-auth-base-url
NEON_AUTH_BASE_URL=https://your-neon-auth-base-url
# Google OAuth client credentials are configured in Neon Console, not here.
DATABASE_URL=postgresql://user:password@ep-placeholder.neon.tech/swatchnet?sslmode=require
# Exact frontend origins allowed by CORS, comma-separated (no trailing slashes).
# Production example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
# ---------------------------------------------------------------------------
# Super Admin bootstrap (server-only, OPTIONAL)
# The Google account that may claim the FIRST Super Admin role. New signups are
# always `user`; this is the only self-service path to `super_admin` and it stops
# working the moment an active Super Admin exists. Leave empty to disable.
# Remove or blank this value after bootstrapping.
SUPER_ADMIN_BOOTSTRAP_EMAIL=
# Points awarded to a volunteer per verified cleanup (default 10).
CLEANUP_POINTS=10

# External APIs - Placeholders
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth client credentials are configured in Neon Console and must not be
# stored here or exposed through VITE_* values. See README "Neon Auth".
