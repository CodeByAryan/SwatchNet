# SwatchNet Environment Configuration (Example)
# Copy this file to .env before running the application

# Server
NODE_ENV=development
PORT=5000

# Client
VITE_API_BASE_URL=http://localhost:5000/api

# Database (PostgreSQL / Neon) - Placeholder
DATABASE_URL=postgresql://user:password@ep-placeholder.neon.tech/swatchnet?sslmode=require

# External APIs - Placeholders
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
