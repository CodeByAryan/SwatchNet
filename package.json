{
  "name": "swatchnet",
  "version": "0.1.0",
  "private": true,
  "description": "SwatchNet monorepo",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:web": "pnpm --filter @swatchnet/web run dev",
    "dev:api": "pnpm --filter @swatchnet/api run dev",
    "build": "pnpm --recursive run build",
    "build:web": "pnpm --filter @swatchnet/web run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "db:generate": "pnpm --filter @swatchnet/api run db:generate",
    "db:migrate": "pnpm --filter @swatchnet/api run db:migrate",
    "db:push": "pnpm --filter @swatchnet/api run db:push",
    "db:studio": "pnpm --filter @swatchnet/api run db:studio"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.13.1"
}